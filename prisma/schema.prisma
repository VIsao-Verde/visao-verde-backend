// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/@types/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthenticationStatus {
  SUCCESS
  USER_NOT_EXISTS
  INCORRECT_PASSWORD
  RECOVER_PASSWORD
  INVALID_TOKEN
  BLOCKED
}

enum UserRole {
  ADMIN
  DEFAULT
}

model AuthenticationAudit {
  id         String               @id @default(uuid(7))
  ipAddress  String?              @map("ip_address")
  remotePort String?              @map("remote_port")
  userAgent  String?              @map("user_agent")
  origin     String?
  status     AuthenticationStatus
  userId     String?              @map("user_id")
  user       User?                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt], name: "idx_auth_audit_user_date")
  @@map("authentication_audit")
}

model User {
  id            String    @id @default(uuid(7))
  name          String
  username      String    @unique
  email         String    @unique
  cpf           String    @unique
  passwordHash  String    @map("password_hash")
  loginAttempts Int       @default(0) @map("login_attempts")
  lastLogin     DateTime? @map("last_login")
  role          UserRole  @default(DEFAULT)

  token          String?   @unique
  tokenExpiresAt DateTime? @map("token_expires_at")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  passwordChangedAt DateTime? @map("password_changed_at")

  authenticationAudits AuthenticationAudit[]
  reviews              Review[]
  coquests             UserConquest[]
  favorites            UserFavoritePark[]
  visits               UserVisitedPark[]

  @@index([name], name: "idx_user_name")
  @@index([token], name: "idx_user_token")
  @@map("users")
}

enum Rating {
  one
  two
  three
  four
  five
}

model Review {
  id      String  @id @default(uuid(7))
  rating  Rating
  comment String?

  userId String @map("user_id")
  parkId String @map("park_id")

  user User @relation(fields: [userId], references: [id])
  park Park @relation(fields: [parkId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

enum Difficulty {
  easy
  moderate
  hard
}

model Trail {
  id          String  @id @default(uuid(7))
  name        String
  description String?

  distanceKm  Float
  durationMin Int?

  difficulty Difficulty

  parkId String @map("park_id")
  park   Park   @relation(fields: [parkId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("trails")
}

model Image {
  id  String @id @default(uuid(7))
  url String

  parkId String @map("park_id")
  park   Park   @relation(fields: [parkId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@map("images")
}

model Park {
  id          String  @id @default(uuid(7))
  name        String
  description String?
  city        String

  latitude  Float
  longitude Float

  location Unsupported("geography(Point,4326)")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  images    Image[]
  trails    Trail[]
  reviews   Review[]
  favorites UserFavoritePark[]
  visits    UserVisitedPark[]

  @@index([latitude, longitude])
  @@map("parks")
}

model Conquest {
  id          String  @id @default(uuid(7))
  name        String
  description String?

  user UserConquest[]

  @@map("conquests")
}

model UserConquest {
  userId      String
  conquestId  String
  achievedAt  DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  conquest  Conquest  @relation(fields: [conquestId], references: [id], onDelete: Cascade)

  @@id([userId, conquestId])
  @@map("user_conquests")
}

model UserFavoritePark {
  userId      String
  parkId      String
  favoritedAt DateTime @default(now()) @map("favorited_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@id([userId, parkId])
  @@map("user_favorite_parks")
}

model UserVisitedPark {
  userId    String
  parkId    String
  visitedAt DateTime @default(now()) @map("visited_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  park Park @relation(fields: [parkId], references: [id], onDelete: Cascade)

  @@id([userId, parkId])
  @@map("user_visited_parks")
}
