{
  "name": "backend-template-reborn",
  "version": "1.0.0",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup src --minify",
    "start:dev": "tsx watch --env-file=.env --no-deprecation src/server.ts",
    "start:prod": "node --env-file=.env build/server.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/jwt": "10.0.0",
    "@fastify/multipart": "10.0.0",
    "@fastify/swagger": "9.7.0",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "@scalar/fastify-api-reference": "1.59.3",
    "@sentry/node": "10.48.0",
    "@sentry/profiling-node": "10.48.0",
    "@supabase/supabase-js": "2.108.1",
    "bcryptjs": "3.0.3",
    "cpf-cnpj-validator": "1.0.3",
    "fastify": "5.8.4",
    "fastify-plugin": "5.1.0",
    "nodemailer": "8.0.11",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "sharp": "0.35.1",
    "uuid": "13.0.0",
    "zod": "4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry-internal/node-cpu-profiler",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/node": "25.9.3",
    "@types/nodemailer": "8.0.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.7.0",
    "ts-jest": "29.4.11",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}
